# SecureDevOps AI Platform Environment Configuration

# MongoDB Atlas Configuration
# Replace with your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
DATABASE_NAME=securedevops

# Alternative: Local MongoDB (if you want to use local instead)
# MONGODB_URI=mongodb://admin:securepass123@localhost:27017/securedevops?authSource=admin
# MONGO_PASSWORD=securepass123

# Security
SECRET_KEY=your-super-secret-key-change-in-production

# OpenAI API Key (for AI-powered features)
OPENAI_API_KEY=your-openai-api-key-here

# Notifications (optional)
SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=

# Redis Password
REDIS_PASSWORD=redispass123

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost,http://frontend

# Rate Limiting
RATE_LIMIT=100
