# SecureDevOps AI Platform - Environment Configuration
# Copy this file to .env and configure your settings

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB Connection URI
# Format: mongodb://username:password@host:port/database?authSource=admin
MONGODB_URI=mongodb://admin:securepass123@mongodb:27017/securedevops?authSource=admin
MONGO_PASSWORD=securepass123

# =============================================================================
# APPLICATION SECURITY
# =============================================================================

# Secret key for JWT tokens and encryption (generate a secure random key)
SECRET_KEY=your-super-secret-key-change-in-production-make-it-long-and-random

# JWT Configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# AI SERVICES
# =============================================================================

# OpenAI API Configuration (Required for AI analysis features)
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.1

# =============================================================================
# NOTIFICATION SERVICES
# =============================================================================

# Slack Integration (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_CHANNEL=#security-alerts

# Microsoft Teams Integration (Optional)
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/TEAMS/WEBHOOK

# Email Notifications (Optional)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@domain.com
EMAIL_SMTP_PASSWORD=your-app-password
EMAIL_FROM_ADDRESS=security@yourcompany.com

# =============================================================================
# CORS AND ACCESS CONTROL
# =============================================================================

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost,https://yourdomain.com

# =============================================================================
# RATE LIMITING
# =============================================================================

# Rate limiting configuration
RATE_LIMIT=100
RATE_LIMIT_WINDOW=3600

# API rate limits per endpoint
SCAN_RATE_LIMIT=10
WEBHOOK_RATE_LIMIT=50

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Environment (development, staging, production)
ENVIRONMENT=production

# Debug mode (true/false)
DEBUG=false

# Server configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# =============================================================================
# SECURITY SCANNER CONFIGURATION
# =============================================================================

# Enable/disable specific scanners
ENABLE_SEMGREP=true
ENABLE_TRIVY=true
ENABLE_GITLEAKS=true
ENABLE_LYNIS=true

# Scanner paths (use system PATH if available)
SEMGREP_PATH=semgrep
TRIVY_PATH=trivy
GITLEAKS_PATH=gitleaks
LYNIS_PATH=lynis

# Scanner timeouts (seconds)
SCAN_TIMEOUT=1800
GIT_CLONE_TIMEOUT=300
SCANNER_TIMEOUT=900

# =============================================================================
# GIT REPOSITORY CONFIGURATION
# =============================================================================

# Git operation settings
GIT_SCAN_TIMEOUT=600
GIT_MAX_REPO_SIZE=500

# Supported Git providers
GITHUB_TOKEN=your-github-token-here
GITLAB_TOKEN=your-gitlab-token-here
BITBUCKET_TOKEN=your-bitbucket-token-here

# =============================================================================
# WEBSOCKET CONFIGURATION
# =============================================================================

# WebSocket settings for real-time updates
WEBSOCKET_HEARTBEAT_INTERVAL=30
WEBSOCKET_TIMEOUT=60

# =============================================================================
# STORAGE AND CACHE
# =============================================================================

# Redis Configuration (for caching and background tasks)
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=redispass123

# Temporary storage
TEMP_DIR=/app/temp
CLEANUP_AFTER_SCAN=true

# File upload limits
MAX_UPLOAD_SIZE=100485760
ALLOWED_EXTENSIONS=.py,.js,.ts,.java,.go,.rs,.php,.rb,.c,.cpp,.cs,.xml,.yaml,.yml,.json,.dockerfile

# =============================================================================
# COMPLIANCE AND REPORTING
# =============================================================================

# Compliance standards to include in reports
COMPLIANCE_STANDARDS=OWASP,NIST,ISO27001,PCI_DSS,SOC2

# Report generation settings
PDF_GENERATION_TIMEOUT=120
REPORT_RETENTION_DAYS=90

# =============================================================================
# MONITORING AND HEALTH CHECKS
# =============================================================================

# Health check configuration
HEALTH_CHECK_TIMEOUT=10
DATABASE_HEALTH_CHECK=true
SCANNER_HEALTH_CHECK=true

# Metrics and monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# =============================================================================
# BACKUP AND MAINTENANCE
# =============================================================================

# Automated backup settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_LOCATION=/app/backups

# Database maintenance
DB_CLEANUP_SCHEDULE=0 3 * * 0
OLD_SCAN_RETENTION_DAYS=30

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================

# Development-only settings (ignored in production)
DEV_RELOAD=true
DEV_PORT=8000
DEV_HOST=0.0.0.0

# Testing configuration
TEST_DATABASE_URL=mongodb://admin:testpass@localhost:27017/securedevops_test?authSource=admin
TEST_OPENAI_API_KEY=sk-test-key

# =============================================================================
# DOCKER AND DEPLOYMENT
# =============================================================================

# Container resource limits
MEMORY_LIMIT=2g
CPU_LIMIT=2

# Docker network configuration
DOCKER_NETWORK=securedevops-network

# =============================================================================
# SSL/TLS CONFIGURATION
# =============================================================================

# SSL certificate paths (for production HTTPS)
SSL_CERT_PATH=/etc/ssl/certs/cert.pem
SSL_KEY_PATH=/etc/ssl/private/key.pem
SSL_CA_PATH=/etc/ssl/certs/ca.pem

# Force HTTPS redirect
FORCE_HTTPS=false

# =============================================================================
# WEBHOOK CONFIGURATION
# =============================================================================

# Webhook security
WEBHOOK_SECRET=your-webhook-secret-here

# Webhook retry configuration
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY=5

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Feature toggles
ENABLE_AI_ANALYSIS=true
ENABLE_COMPLIANCE_REPORTS=true
ENABLE_WEBHOOK_ENDPOINTS=true
ENABLE_USER_AUTHENTICATION=false
ENABLE_TEAM_MANAGEMENT=false

# Experimental features
ENABLE_ML_RISK_PREDICTION=false
ENABLE_CUSTOM_RULES=false

# =============================================================================
# NOTES
# =============================================================================

# Security Notes:
# 1. Change all default passwords and secrets
# 2. Use strong, randomly generated SECRET_KEY
# 3. Configure proper CORS origins for production
# 4. Enable SSL/TLS in production
# 5. Use environment-specific values for each deployment
# 6. Never commit this file with real secrets to version control
# 7. Consider using a secrets management system for production

# Performance Notes:
# 1. Adjust WORKERS based on CPU cores (2 * cores + 1)
# 2. Configure rate limits based on expected load
# 3. Set appropriate timeouts for your environment
# 4. Monitor resource usage and adjust limits accordingly

# Compliance Notes:
# 1. Enable audit logging for compliance requirements
# 2. Configure data retention policies
# 3. Set up proper backup and disaster recovery
# 4. Document security configurations for audits
