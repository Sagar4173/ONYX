# ONYX frontend production build configuration.
# Copy this file to /home/ec2-user/ONYX/frontend/.env on the host.
# Never commit the real file.

# Same-origin deployment through host nginx.
VITE_API_URL=/api

# Leave blank to derive wss:// from the current page host.
VITE_WS_URL=

VITE_APP_NAME=ONYX Security Intelligence Platform
VITE_ENVIRONMENT=production
