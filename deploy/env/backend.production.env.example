# ONYX backend production configuration.
# Copy this file to /home/ec2-user/ONYX/backend/.env on the host and replace
# every placeholder value. Never commit the real file.
#
# Generate secrets with:
#   openssl rand -hex 32

ENVIRONMENT=production
DEBUG=false
SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32
HOST=127.0.0.1
PORT=8000
WORKERS=1

# Use MongoDB Atlas or an authenticated local MongoDB URI.
# Do not use an unauthenticated database exposed to the network.
MONGODB_URI=REPLACE_WITH_AUTHENTICATED_MONGODB_URI
DATABASE_NAME=onyx

# Public origin used by CORS, cookies, and generated links.
FRONTEND_URL=https://onyx.ajuna.website
CORS_ORIGINS=https://onyx.ajuna.website
ALLOWED_ORIGINS=https://onyx.ajuna.website

# Webhook endpoints fail closed when this is unset.
WEBHOOK_SECRET=REPLACE_WITH_openssl_rand_hex_32

# Keep registration open until the first administrator exists, then decide
# whether to disable it for your deployment.
ALLOW_REGISTRATION=true
# Enable this only after SMTP is configured.
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_ENABLED=false

# AI is optional. Leave keys empty to run without AI features.
AI_PROVIDER=auto
AI_PROVIDER_CHAIN=gemini,groq,openrouter,ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-27b-it:free
OPENAI_API_KEY=
AI_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
AI_LOCAL_MODEL=qwen2.5-coder:3b

# Runtime storage. The systemd unit runs with PrivateTmp, so /tmp is private
# to the service and safe to use.
TEMP_DIR=/tmp/onyx
KNOWLEDGE_DB_PATH=data/knowledge.db
LOG_LEVEL=INFO
ENABLE_PROMETHEUS=true
