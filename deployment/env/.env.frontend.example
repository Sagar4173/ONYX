# ONYX Frontend - Environment Variables Template
# For Vercel: Set these in Dashboard → Settings → Environment Variables
# For local: Create .env file in frontend/ folder

# =============================================================================
# API Configuration
# =============================================================================
# Backend API URL
# Development: http://localhost:8000/api
# Production: https://onyx-backend-dt4o.onrender.com/api
VITE_API_URL=http://localhost:8000/api

# WebSocket URL for real-time features
# Development: ws://localhost:8000
# Production: wss://onyx-backend-dt4o.onrender.com
VITE_WS_URL=ws://localhost:8000

# =============================================================================
# Application
# =============================================================================
VITE_APP_NAME=ONYX
VITE_APP_VERSION=1.0.0

# =============================================================================
# Feature Flags (Optional)
# =============================================================================
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_DARK_MODE=true
