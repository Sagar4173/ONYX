# ONYX Backend - Environment Variables Template
# For Render: Set these in Dashboard → Your Service → Environment
# For local: Create .env file in backend/ folder

# =============================================================================
# DATABASE (Required)
# =============================================================================
# MongoDB connection string
# Format: mongodb+srv://username:password@cluster.xxx.mongodb.net/database
MONGODB_URI=mongodb+srv://user:password@cluster.xxx.mongodb.net/onyx?retryWrites=true&w=majority

# =============================================================================
# SECURITY (Required)
# =============================================================================
# Secret key for JWT - MUST be changed in production
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-string

# JWT Settings
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# APPLICATION (Required)
# =============================================================================
# Environment: development, production
ENVIRONMENT=production

# =============================================================================
# CORS (Required)
# =============================================================================
# Frontend URLs allowed to access the API (comma-separated)
# Example: https://onyx-platform.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=https://onyx-platform.vercel.app

# =============================================================================
# AI PROVIDERS (Optional)
# =============================================================================
# OpenAI - for AI-powered vulnerability analysis
OPENAI_API_KEY=sk-your-openai-key

# Google Gemini - alternative AI provider
GEMINI_API_KEY=your-gemini-key

# Google AI API
GOOGLE_AI_API_KEY=your-google-ai-key

# =============================================================================
# SCANNING TOOLS (Auto-configured)
# =============================================================================
# These are typically auto-detected, but can be overridden
# SEMGREP_PATH=/usr/local/bin/semgrep
# GITLEAKS_PATH=/usr/local/bin/gitleaks
# TRIVY_PATH=/usr/local/bin/trivy

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
DEBUG=false
