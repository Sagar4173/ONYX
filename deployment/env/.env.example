# ONYX Platform - Environment Variables Template
# Copy this file and rename to .env, then fill in your values
# Usage: cp .env.example .env

# =============================================================================
# DATABASE
# =============================================================================
# MongoDB connection string
# Local: mongodb://localhost:27017/onyx
# Docker: mongodb://mongodb:27017/onyx
# Atlas: mongodb+srv://user:password@cluster.xxx.mongodb.net/onyx
MONGODB_URI=mongodb://localhost:27017/onyx

# =============================================================================
# SECURITY
# =============================================================================
# Secret key for JWT tokens (generate a secure random string)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-this-in-production

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# APPLICATION
# =============================================================================
# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (set to false in production)
DEBUG=true

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =============================================================================
# CORS
# =============================================================================
# Allowed origins for CORS (comma-separated)
# Development: http://localhost:3000,http://localhost:5173
# Production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# AI PROVIDERS (Optional)
# =============================================================================
# OpenAI API Key (for AI-powered features)
OPENAI_API_KEY=

# Google Gemini API Key (alternative AI provider)
GEMINI_API_KEY=

# Google AI API Key
GOOGLE_AI_API_KEY=

# AI Provider: openai or gemini
AI_PROVIDER=openai

# =============================================================================
# NOTIFICATIONS (Optional)
# =============================================================================
# Slack webhook for notifications
SLACK_WEBHOOK_URL=

# Microsoft Teams webhook
TEAMS_WEBHOOK_URL=

# =============================================================================
# EMAIL (Optional)
# =============================================================================
# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourdomain.com

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
