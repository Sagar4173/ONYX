# ==============================================================================
# ONYX Backend - Production Environment Configuration
# ==============================================================================
# Set these variables in your Render/Railway deployment dashboard
# ==============================================================================

# ==============================================================================
# REQUIRED SETTINGS
# ==============================================================================

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/onyx

# JWT Secret Key (generate with: openssl rand -hex 32)
SECRET_KEY=your-production-secret-key

# CORS - Your frontend URL(s)
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Environment
ENVIRONMENT=production

# ==============================================================================
# AI CONFIGURATION (Required for AI features)
# ==============================================================================

# Provider: "openai" or "gemini"
AI_PROVIDER=gemini

# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-key

# Google Gemini API Key
GEMINI_API_KEY=your-gemini-key

# ==============================================================================
# EMAIL CONFIGURATION (Required for notifications)
# ==============================================================================

EMAIL_ENABLED=true

# Option 1: Use EMAIL_PROVIDER preset (auto-configures SMTP server/port)
# Supported: gmail, outlook, yahoo, sendgrid
EMAIL_PROVIDER=gmail
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Option 2: Custom SMTP (if EMAIL_PROVIDER not set)
# SMTP_SERVER=smtp.yourprovider.com
# SMTP_PORT=587

# Optional: Customize sender (defaults to SMTP_USERNAME)
# EMAIL_FROM=noreply@yourdomain.com
# EMAIL_FROM_NAME=ONYX Platform

# ==============================================================================
# PRODUCTION SETTINGS
# ==============================================================================

DEBUG=false
FORCE_HTTPS=true
PORT=8000
