# ==============================================================================
# ONYX Security Intelligence Platform - Environment Configuration
# ==============================================================================
# Copy this file to .env and update values for your environment
# cp .env.example .env
# ==============================================================================

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
APP_NAME="ONYX Security Intelligence Platform"
APP_VERSION="1.0.0"
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=4
ENVIRONMENT=development

# ==============================================================================
# URL CONFIGURATION
# ==============================================================================
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:80
API_BASE_URL=http://localhost:8000
WEBSOCKET_URL=ws://localhost:8000

# ==============================================================================
# DATABASE CONFIGURATION
# ==============================================================================
# Local MongoDB (Docker): mongodb://mongodb:27017/onyx
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/onyx
MONGODB_URI=mongodb://localhost:27017/onyx
DATABASE_NAME=onyx

# ==============================================================================
# SECURITY CONFIGURATION
# ==============================================================================
# Generate a strong random key: openssl rand -hex 32
SECRET_KEY=change-me-to-a-random-secret-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
FORCE_HTTPS=false

# ==============================================================================
# AUTHENTICATION SETTINGS
# ==============================================================================
ALLOW_REGISTRATION=true
REQUIRE_EMAIL_VERIFICATION=false
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# Google SSO (optional) - uncomment to enable "Sign in with Google"
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_ALLOWED_DOMAINS=yourcompany.com,corp.example.org

# ==============================================================================
# AI CONFIGURATION
# ==============================================================================
# Provider: auto (default, follows AI_PROVIDER_CHAIN), or a single provider:
#   ollama | openai | gemini | groq | openrouter
AI_PROVIDER=auto
# Failover chain used when AI_PROVIDER=auto (left -> right)
AI_PROVIDER_CHAIN=gemini,groq,openrouter,ollama
# Google Gemini (primary free tier)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=2000
# Groq (free tier fallback, OpenAI-compatible)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b
# OpenRouter (free tier fallback, OpenAI-compatible)
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=google/gemma-4-27b-it:free
# OpenAI (optional legacy fallback)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000
# Ollama (local dev, zero-cost; keep last in chain)
AI_LOCAL_BASE_URL=http://ollama:11434/v1
AI_LOCAL_MODEL=qwen2.5-coder:7b
AI_LOCAL_TIMEOUT=120
# AI gateway governance (budget protection)
AI_RATE_LIMIT_RPM=15
AI_RATE_LIMIT_RPD=500
AI_CACHE_TTL_DAYS=7
AI_ENRICH_TOP_N=10
AI_POST_SCAN_CONCURRENCY=2

# ==============================================================================
# EMAIL CONFIGURATION
# ==============================================================================
EMAIL_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=noreply@onyx.com
EMAIL_FROM_NAME=ONYX Platform
EMAIL_PROVIDER=gmail

# ==============================================================================
# CORS CONFIGURATION
# ==============================================================================
CORS_ORIGINS=http://localhost:80,http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:80,http://localhost:5173

# ==============================================================================
# RATE LIMITING
# ==============================================================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
RATE_LIMIT_PER_MINUTE=1000
RATE_LIMIT_BURST=100

# ==============================================================================
# SECURITY SCANNER CONFIGURATION
# ==============================================================================
ENABLE_SEMGREP=false
ENABLE_TRIVY=false
ENABLE_GITLEAKS=false
ENABLE_LYNIS=false
SCAN_TIMEOUT=300
MAX_CONCURRENT_SCANS=3

# ==============================================================================
# REDIS CONFIGURATION
# ==============================================================================
REDIS_URL=redis://localhost:6379
REDIS_DB=0

# ==============================================================================
# LOGGING CONFIGURATION
# ==============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# ==============================================================================
# GIT OPERATIONS
# ==============================================================================
GIT_CLONE_TIMEOUT=300
GIT_SCAN_TIMEOUT=600

# ==============================================================================
# WEBSOCKET CONFIGURATION
# ==============================================================================
WEBSOCKET_HEARTBEAT_INTERVAL=30

# ==============================================================================
# STORAGE CONFIGURATION
# ==============================================================================
TEMP_DIR=/tmp/securedevops
CLEANUP_AFTER_SCAN=true

# ==============================================================================
# MONITORING
# ==============================================================================
SENTRY_DSN=
ENABLE_PROMETHEUS=true

# DEVELOPMENT SETTINGS
# ==============================================================================
USE_MOCK_SCANNERS=true
VERBOSE_LOGGING=false

# ==============================================================================
# PHASE 2: RAG / KNOWLEDGE RETRIEVAL
# ==============================================================================
# Single SQLite file holding vectors (sqlite-vec) + full-text index (FTS5).
KNOWLEDGE_DB_PATH=data/knowledge.db
# Embedding provider chain: Gemini free tier, then Ollama. Dimensions must
# match between provider and stored vectors (768 works for both defaults).
AI_EMBED_MODEL=gemini-embedding-2
AI_EMBED_LOCAL_MODEL=nomic-embed-text
AI_EMBED_DIMENSIONS=768
AI_EMBED_BATCH_SIZE=16
# Retrieval: blocks returned per query, RRF fusion constant, context cap.
RAG_TOP_K=6
RAG_RRF_K=60
RAG_MAX_CONTEXT_CHARS=6000
