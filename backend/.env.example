# ==============================================================================
# ONYX Security Intelligence Platform — Backend Environment TEMPLATE
# ==============================================================================
# Copy to .env and fill in the REPLACE_WITH_... placeholders:
#   cp .env.example .env
#
# Every variable below is read by the backend (config.py Settings, plus a few
# direct os.getenv reads: ENVIRONMENT, MONGODB_URI, MONGO_PASSWORD,
# DATABASE_NAME, PORT). Values shown are working dev defaults.
#
# Minimum to run locally: SECRET_KEY (openssl rand -hex 32) and a MONGODB_URI
# (Atlas, local mongod, or docker-compose). Everything else has safe defaults.
#
# docker-compose.yml loads .env and overrides MONGODB_URI/HOST/PORT/
# BACKEND_URL/FRONTEND_URL for containers.
# NEVER commit .env (it is gitignored); this .example file is the committed one.
# ==============================================================================


# ==============================================================================
# 1. REQUIRED — app will not start / auth will not work without these
# ==============================================================================

# JWT signing key (min 32 chars). Generate: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32

# Database — pick ONE, uncomment it:
#
# [A] MongoDB Atlas (cloud, recommended for dev laptops)
#     Remember to allow this machine's IP in the Atlas Network Access list.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/onyx
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/onyx?retryWrites=true&w=majority
#
# [B] Local MongoDB / Docker Desktop on this machine
# MONGODB_URI=mongodb://localhost:27017/onyx
#
# [C] docker-compose managed MongoDB (hostname "mongodb" resolves in-network;
#     compose already forces this via its environment block)
# MONGODB_URI=mongodb://mongodb:27017/onyx

DATABASE_NAME=onyx
# Only needed when MONGODB_URI contains the literal "<db_password>" placeholder:
# MONGO_PASSWORD=


# ==============================================================================
# 2. APPLICATION
# ==============================================================================
APP_NAME="ONYX Security Intelligence Platform"
APP_VERSION="1.0.0"
DEBUG=true
HOST=0.0.0.0
PORT=8000
WORKERS=4
ENVIRONMENT=development


# ==============================================================================
# 3. URLS (dev values; compose overrides these for containers)
# ==============================================================================
BACKEND_URL=http://localhost:8000
# Vite dev server; docker/nginx prod serves the SPA on :80
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:8000
WEBSOCKET_URL=ws://localhost:8000


# ==============================================================================
# 4. AUTHENTICATION
# ==============================================================================
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
FORCE_HTTPS=false

ALLOW_REGISTRATION=true
# Keep false for local dev so you can register/login without email setup
REQUIRE_EMAIL_VERIFICATION=false
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MINUTES=30

# Google SSO (optional) — uncomment BOTH to enable "Continue with Google"
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# GOOGLE_ALLOWED_DOMAINS=yourcompany.com,example.org


# ==============================================================================
# 5. AI PROVIDERS
#    AI_PROVIDER=auto walks AI_PROVIDER_CHAIN left -> right, skipping entries
#    whose API key is missing/placeholder. Keys need 11+ chars to count as set.
# ==============================================================================
AI_PROVIDER=auto
AI_PROVIDER_CHAIN=gemini,groq,openrouter,ollama

# Google Gemini (primary free tier)
# Paste your key after the = (empty = provider skipped by AI_PROVIDER_CHAIN)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=2000

# Groq (free-tier fallback, OpenAI-compatible)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter (free-tier fallback, OpenAI-compatible)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-27b-it:free

# OpenAI (optional legacy fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2000

# Ollama (local, zero-cost; keep last in chain)
# In docker-compose this resolves to the ollama service; on a bare laptop use
# http://localhost:11434/v1 if Ollama runs locally.
AI_LOCAL_BASE_URL=http://localhost:11434/v1
AI_LOCAL_MODEL=qwen2.5-coder:7b
AI_LOCAL_TIMEOUT=120

# Gateway governance (budget protection)
AI_RATE_LIMIT_RPM=15
AI_RATE_LIMIT_RPD=500
AI_CACHE_TTL_DAYS=7
AI_ENRICH_TOP_N=10
AI_POST_SCAN_CONCURRENCY=2


# ==============================================================================
# 6. RAG / KNOWLEDGE RETRIEVAL (Phase 2)
#    One SQLite file holds vectors (sqlite-vec) + full-text (FTS5).
# ==============================================================================
KNOWLEDGE_DB_PATH=data/knowledge.db
AI_EMBED_MODEL=gemini-embedding-2
AI_EMBED_LOCAL_MODEL=nomic-embed-text
AI_EMBED_DIMENSIONS=768
AI_EMBED_BATCH_SIZE=16
RAG_TOP_K=6
RAG_RRF_K=60
RAG_MAX_CONTEXT_CHARS=6000


# ==============================================================================
# 7. AGENTIC FIX-AGENT + AI SAFETY (Phase 3)
# ==============================================================================
# true = propose only; PR opens on explicit /approve
AUTO_FIX_REQUIRES_APPROVAL=true
# true = never persist/push/PR; gated diff only
AUTO_FIX_DRY_RUN=false
AUTO_FIX_MAX_DIFF_LINES=50
FIX_AGENT_MAX_TOOL_RETRIES=2
FIX_AGENT_OUTPUT_TOKEN_LIMIT=4000

# Inbound prompt-injection screening (Groq free lane)
INJECTION_SCREEN_ENABLED=true
# false = fail closed (503) when the classifier is unreachable
INJECTION_SCREEN_FAIL_OPEN=true
INJECTION_SCREEN_MODEL=meta-llama/llama-prompt-guard-2-86m


# ==============================================================================
# 8. INVESTIGATE AGENT + ML TRIAGE (Phase 4)
# ==============================================================================
INVESTIGATE_AGENT_ENABLED=true
INVESTIGATE_AGENT_MAX_TOOL_RETRIES=2
INVESTIGATE_AGENT_OUTPUT_TOKEN_LIMIT=3000
ML_ISOLATION_FOREST_ENABLED=false
ML_MIN_TRAINING_SCANS=30
ML_TRAINING_WINDOW_DAYS=90


# ==============================================================================
# 9. SCANNERS
#    Core scanners ship with the app (pip-installed). Optional scanners need
#    the external binary on PATH (or a path override further down).
# ==============================================================================
ENABLE_SEMGREP=true
ENABLE_BANDIT=true
ENABLE_SAFETY=true
ENABLE_GITLEAKS=true
# External-tool scanners — enable only when the tool is installed
ENABLE_TRIVY=false
ENABLE_LYNIS=false
ENABLE_ZAP=false
ENABLE_NUCLEI=false
ENABLE_CODEQL=false
ENABLE_CHECKOV=false
SCAN_TIMEOUT=300
MAX_CONCURRENT_SCANS=3

# Custom rules (optional)
# CUSTOM_SEMGREP_RULES_REPO=https://github.com/org/semgrep-rules
# CUSTOM_GITLEAKS_CONFIG=.gitleaks.toml

# Scanner binary paths (only if not on PATH)
# SEMGREP_PATH=semgrep
# TRIVY_PATH=trivy
# GITLEAKS_PATH=gitleaks
# LYNIS_PATH=lynis
# ZAP_API_URL=http://localhost:8080
# NUCLEI_PATH=nuclei
# CODEQL_PATH=codeql
# BANDIT_PATH=bandit
# SAFETY_PATH=safety
# TRIVY_CACHE_DIR=/tmp/trivy-cache
# TRIVY_DB_UPDATE_INTERVAL=24

# Git clone/scan timeouts (seconds)
GIT_CLONE_TIMEOUT=300
GIT_SCAN_TIMEOUT=600


# ==============================================================================
# 10. WEBHOOKS + AUTO-FIX PRs
#     WEBHOOK_SECRET unset = webhook endpoints return 503 (fail closed).
# ==============================================================================
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=
AUTO_FIX_BRANCH_PREFIX=onyx-auto-fix/
AUTO_FIX_PR_TITLE_PREFIX=[ONYX Auto-Fix]
# PR creation requires a per-project repository access_token.


# ==============================================================================
# 11. CORS
#      Dev default list is built in when these are empty; set them explicitly
#      for anything beyond localhost. Compose/nginx same-origin needs no extra.
# ==============================================================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://localhost:80
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80


# ==============================================================================
# 12. EMAIL (disabled by default; REQUIRE_EMAIL_VERIFICATION must stay false)
# ==============================================================================
EMAIL_ENABLED=false
EMAIL_PROVIDER=gmail
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM=noreply@onyx.local
EMAIL_FROM_NAME=ONYX Platform


# ==============================================================================
# 13. NOTIFICATIONS (optional)
# ==============================================================================
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX
# SLACK_CHANNEL=#dev-alerts
# TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/XXXX


# ==============================================================================
# 14. LOGGING / STORAGE / MONITORING
# ==============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# Scan scratch space. Windows note: "/tmp/..." resolves oddly — prefer e.g.
# TEMP_DIR=C:/Users/<you>/AppData/Local/Temp/onyx  or leave the default.
TEMP_DIR=/tmp/onyx
CLEANUP_AFTER_SCAN=true

SENTRY_DSN=
ENABLE_PROMETHEUS=true

WEBSOCKET_HEARTBEAT_INTERVAL=30


# ==============================================================================
# 15. RESERVED / NOT YET WIRED (kept for future use; safe to leave as-is)
# ==============================================================================
REDIS_URL=redis://localhost:6379
REDIS_DB=0
# Legacy knobs not read by current slowapi per-route limits:
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600
RATE_LIMIT_PER_MINUTE=1000
RATE_LIMIT_BURST=100
