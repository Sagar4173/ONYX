# SecureDevOps AI Platform Environment Configuration
# Copy this file to .env and fill in your values

# Application Settings
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Security
SECRET_KEY=your-secret-key-here-make-it-long-and-random
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=securedevops

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# Notification Services (optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/YOUR/TEAMS/WEBHOOK

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_SIZE=10485760
LOG_BACKUP_COUNT=5

# Scanner Paths (use defaults if installed in PATH)
SEMGREP_PATH=semgrep
TRIVY_PATH=trivy
GITLEAKS_PATH=gitleaks
LYNIS_PATH=lynis

# Git Operations
GIT_CLONE_TIMEOUT=300
GIT_SCAN_TIMEOUT=600

# WebSocket
WEBSOCKET_HEARTBEAT_INTERVAL=30

# Storage
TEMP_DIR=/tmp/securedevops
CLEANUP_AFTER_SCAN=true
