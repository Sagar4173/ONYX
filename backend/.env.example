# ==============================================================================
# ONYX Backend - Production Environment Configuration
# ==============================================================================
# Set these variables in your Render/Railway deployment dashboard
# ==============================================================================

# ==============================================================================
# REQUIRED SETTINGS
# ==============================================================================

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/onyx

# JWT Secret Key (generate with: openssl rand -hex 32)
SECRET_KEY=your-production-secret-key

# CORS - Your frontend URL(s)
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Environment
ENVIRONMENT=production

# ==============================================================================
# AI CONFIGURATION (Required for AI features)
# ==============================================================================

# Provider: "openai" or "gemini"
AI_PROVIDER=gemini

# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-key

# Google Gemini API Key
GEMINI_API_KEY=your-gemini-key

# ==============================================================================
# EMAIL CONFIGURATION
# ==============================================================================

EMAIL_ENABLED=true

# Option 1: Resend API (RECOMMENDED for Render/cloud platforms - SMTP blocked)
# Sign up at https://resend.com (free: 3000 emails/month)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=onboarding@resend.dev

# Option 2: SMTP (for local/self-hosted - NOT for Render)
# EMAIL_PROVIDER=gmail
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Optional: Customize sender name
# EMAIL_FROM_NAME=ONYX Platform

# ==============================================================================
# PRODUCTION SETTINGS
# ==============================================================================

DEBUG=false
FORCE_HTTPS=true
PORT=8000
