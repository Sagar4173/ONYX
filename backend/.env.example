# ==============================================================================
# ONYX Backend - Production Environment Configuration
# ==============================================================================
# Set these variables in your Render/Railway deployment dashboard
# ==============================================================================

# ==============================================================================
# REQUIRED SETTINGS
# ==============================================================================

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/onyx

# JWT Secret Key (generate with: openssl rand -hex 32)
SECRET_KEY=your-production-secret-key

# CORS - Your frontend URL(s)
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Environment
ENVIRONMENT=production

# ==============================================================================
# AI CONFIGURATION (Required for AI features)
# ==============================================================================

# Provider: "openai" or "gemini"
AI_PROVIDER=gemini

# OpenAI API Key
OPENAI_API_KEY=sk-your-openai-key

# Google Gemini API Key
GEMINI_API_KEY=your-gemini-key

# ==============================================================================
# EMAIL CONFIGURATION
# ==============================================================================

EMAIL_ENABLED=true

# Option 1: Brevo API (RECOMMENDED for Render/cloud platforms - SMTP blocked)
# Sign up at https://brevo.com (free: 300 emails/day, NO domain verification needed)
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-your-api-key-here
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=ONYX Platform

# Option 2: SMTP (for local/self-hosted - NOT for Render)
# EMAIL_PROVIDER=gmail
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# ==============================================================================
# PRODUCTION SETTINGS
# ==============================================================================

DEBUG=false
FORCE_HTTPS=true
PORT=8000
