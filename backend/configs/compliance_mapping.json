  "threat_categories": {
    "injection": {
      "description": "Injection flaws allow attackers to send hostile data to an interpreter",
      "typical_severity": "high",
      "remediation_priority": "high",
      "examples": ["SQL Injection", "Command Injection", "LDAP Injection", "XSS"]
    },
    "authentication": {
      "description": "Authentication and session management vulnerabilities",
      "typical_severity": "high",
      "remediation_priority": "high",
      "examples": ["Broken Authentication", "Session Fixation", "Weak Passwords"]
    },
    "authorization": {
      "description": "Access control and authorization failures",
      "typical_severity": "medium",
      "remediation_priority": "medium",
      "examples": ["Privilege Escalation", "Missing Authorization", "IDOR"]
    },
    "cryptography": {
      "description": "Cryptographic failures and weak encryption",
      "typical_severity": "medium",
      "remediation_priority": "medium",
      "examples": ["Weak Encryption", "Broken Crypto", "Key Management Issues"]
    },
    "data_exposure": {
      "description": "Sensitive data exposure vulnerabilities",
      "typical_severity": "medium",
      "remediation_priority": "high",
      "examples": ["Data Leaks", "PII Exposure", "Information Disclosure"]
    },
    "configuration": {
      "description": "Security misconfigurations",
      "typical_severity": "low",
      "remediation_priority": "medium",
      "examples": ["Default Configs", "Debug Mode", "Insecure Settings"]
    },
    "dependency": {
      "description": "Vulnerable dependencies and components",
      "typical_severity": "varies",
      "remediation_priority": "medium",
      "examples": ["Known CVEs", "Outdated Libraries", "Vulnerable Packages"]
    },
    "secrets": {
      "description": "Exposed secrets and credentials",
      "typical_severity": "high",
      "remediation_priority": "critical",
      "examples": ["API Keys", "Passwords", "Private Keys", "Tokens"]
    }
  },
  "MITRE_ATTACK": {
    "framework_info": {
      "name": "MITRE ATT&CK",
      "version": "v14.1",
      "description": "MITRE ATT&CK is a globally accessible knowledge base of adversary tactics and techniques based on real-world observations"
    },
    "controls": {
      "TA0006": {
        "title": "Credential Access",
        "description": "Techniques for stealing credentials like account names and passwords",
        "category": "credential_access",
        "scanner_mappings": [
          {"scanner": "semgrep", "rules": ["hardcoded-password", "hardcoded-secret", "weak-authentication", "sql-injection"]},
          {"scanner": "gitleaks", "rules": ["password", "api-key", "private-key", "aws-access-key"]},
          {"scanner": "detect-secrets", "rules": ["High Entropy String", "Private Key"]},
          {"scanner": "bandit", "rules": ["B105", "B106", "B107", "B108"]}
        ]
      },
      "TA0001": {
        "title": "Initial Access",
        "description": "Techniques that use various entry vectors to gain initial foothold",
        "category": "initial_access",
        "scanner_mappings": [
          {"scanner": "semgrep", "rules": ["sql-injection", "command-injection", "path-traversal", "ssrf"]},
          {"scanner": "nuclei", "rules": ["cve", "misconfiguration"]},
          {"scanner": "zap", "rules": ["sql-injection", "xss", "path-traversal"]}
        ]
      },
      "TA0002": {
        "title": "Execution",
        "description": "Techniques that result in adversary-controlled code execution",
        "category": "execution",
        "scanner_mappings": [
          {"scanner": "semgrep", "rules": ["command-injection", "deserialization", "code-execution"]},
          {"scanner": "bandit", "rules": ["B602", "B603", "B604"]},
          {"scanner": "nuclei", "rules": ["rce", "code-execution"]}
        ]
      },
      "TA0005": {
        "title": "Defense Evasion",
        "description": "Techniques adversaries use to avoid detection",
        "category": "defense_evasion",
        "scanner_mappings": [
          {"scanner": "semgrep", "rules": ["improper-certificate-validation", "disabled-security-feature"]},
          {"scanner": "lynis", "rules": ["FILE-6310", "KRNL-5788"]},
          {"scanner": "checkov", "rules": ["CKV_AWS_1", "CKV_AWS_2"]}
        ]
      },
      "TA0040": {
        "title": "Impact",
        "description": "Techniques that manipulate, interrupt, or destroy systems and data",
        "category": "impact",
        "scanner_mappings": [
          {"scanner": "semgrep", "rules": ["insecure-deserialization", "path-traversal"]},
          {"scanner": "nuclei", "rules": ["denial-of-service", "misconfiguration"]}
        ]
      },
      "TA0007": {
        "title": "Discovery",
        "description": "Techniques adversaries use to gain knowledge about the system",
        "category": "discovery",
        "scanner_mappings": [
          {"scanner": "semgrep", "rules": ["information-disclosure", "debug-enabled"]},
          {"scanner": "bandit", "rules": ["B201"]},
          {"scanner": "lynis", "rules": ["LOGG-2108", "LOGG-2130"]}
        ]
      },
      "TA0009": {
        "title": "Collection",
        "description": "Techniques used to gather information before exfiltration",
        "category": "collection",
        "scanner_mappings": [
          {"scanner": "semgrep", "rules": ["information-disclosure", "pii-leakage"]},
          {"scanner": "bandit", "rules": ["B108"]}
        ]
      },
      "TA0010": {
        "title": "Exfiltration",
        "description": "Techniques adversaries use to steal data from the network",
        "category": "exfiltration",
        "scanner_mappings": [
          {"scanner": "semgrep", "rules": ["information-disclosure", "ssrf"]},
          {"scanner": "trivy", "rules": ["vulnerable-package"]}
        ]
      },
      "T1190": {
        "title": "Exploit Public-Facing Application",
        "description": "Adversaries exploit weaknesses in public-facing applications",
        "category": "initial_access",
        "scanner_mappings": [
          {"scanner": "nuclei", "rules": ["cve", "vulnerability"]},
          {"scanner": "zap", "rules": ["sql-injection", "xss"]},
          {"scanner": "semgrep", "rules": ["sql-injection", "command-injection"]}
        ]
      },
      "T1568": {
        "title": "Dynamic Resolution",
        "description": "Adversaries use dynamic DNS and other techniques to resolve connections",
        "category": "command_and_control",
        "scanner_mappings": [
          {"scanner": "nuclei", "rules": ["dns", "misconfiguration"]},
          {"scanner": "lynis", "rules": ["DNS-1602", "DNS-1642"]}
        ]
      }
    }
  }
