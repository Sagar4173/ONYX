            {"scanner": "semgrep", "rules": ["weak-crypto", "hardcoded-crypto-key", "insecure-random"]},
            {"scanner": "bandit", "rules": ["B303", "B304", "B305"]},
            {"scanner": "gitleaks", "rules": ["private-key", "encryption-key"]}
          ]
        },
        "SI-2": {
          "title": "Flaw Remediation",
          "description": "Identify, report, and correct information system flaws",
          "category": "vulnerability_management",
          "scanner_mappings": [
            {"scanner": "safety", "rules": ["known-vulnerability", "cve-found", "outdated-package"]},
            {"scanner": "trivy", "rules": ["CVE-HIGH", "CVE-CRITICAL", "OUTDATED-PACKAGE"]}
          ]
        },
        "SI-4": {
          "title": "System Monitoring",
          "description": "Monitor the information system to detect attacks and unauthorized connections",
          "category": "system_monitoring",
          "scanner_mappings": [
            {"scanner": "semgrep", "rules": ["missing-security-logging", "debug-info-leak"]},
            {"scanner": "lynis", "rules": ["FIRE-4512", "FIRE-4513", "LOGG-2154"]}
          ]
        }
      }
    },
    "CIS": {
      "framework_info": {
        "name": "CIS Critical Security Controls",
        "version": "v8",
        "description": "Center for Internet Security prioritized set of actions to protect organizations from cyber threats"
      },
      "controls": {
        "4.1": {
          "title": "Secure Configuration of Enterprise Assets",
          "description": "Establish and maintain secure configurations of enterprise assets",
          "category": "configuration",
          "scanner_mappings": [
            {"scanner": "semgrep", "rules": ["debug-mode", "default-config", "insecure-config"]},
            {"scanner": "lynis", "rules": ["HRDN-7222", "HRDN-7230"]}
          ]
        },
        "7.1": {
          "title": "Continuous Vulnerability Management",
          "description": "Perform automated vulnerability scans of internal enterprise assets",
          "category": "vulnerability_management",
          "scanner_mappings": [
            {"scanner": "safety", "rules": ["known-vulnerability", "cve-found"]},
            {"scanner": "trivy", "rules": ["CVE-HIGH", "CVE-CRITICAL"]}
          ]
        },
        "8.1": {
          "title": "Audit Log Management",
          "description": "Collect and maintain audit logs for enterprise assets",
          "category": "logging",
          "scanner_mappings": [
            {"scanner": "semgrep", "rules": ["missing-security-logging", "log-injection"]},
            {"scanner": "lynis", "rules": ["LOGG-2154", "LOGG-2190", "LOGG-2210"]}
          ]
        },
        "10.1": {
          "title": "Malware Defenses",
          "description": "Deploy and maintain anti-malware software and scanning",
          "category": "defense",
          "scanner_mappings": [
            {"scanner": "trivy", "rules": ["MALWARE-SCAN", "CONTAINER-SECURITY"]},
            {"scanner": "lynis", "rules": ["HRDN-7222", "FIRE-4512"]}
          ]
        },
        "13.1": {
          "title": "Network Monitoring and Defense",
          "description": "Monitor and defend the enterprise network",
          "category": "system_monitoring",
          "scanner_mappings": [
            {"scanner": "lynis", "rules": ["FIRE-4512", "FIRE-4513", "NETW-4514"]},
            {"scanner": "trivy", "rules": ["NETWORK-SECURITY"]}
          ]
        },
        "16.1": {
          "title": "Application Software Security",
          "description": "Secure development and deployment of application software",
          "category": "secure_development",
          "scanner_mappings": [
            {"scanner": "semgrep", "rules": ["sql-injection", "xss", "command-injection", "path-traversal"]},
            {"scanner": "bandit", "rules": ["B201", "B602", "B605", "B608", "B609"]},
            {"scanner": "codeql", "rules": ["java/sql-injection", "js/xss", "py/path-injection"]}
          ]
        },
        "18.1": {
          "title": "Penetration Testing",
          "description": "Conduct regular penetration testing of enterprise assets",
          "category": "testing",
          "scanner_mappings": [
            {"scanner": "nuclei", "rules": ["critical-severity", "high-severity"]},
            {"scanner": "zap", "rules": ["passive-scan", "active-scan"]}
          ]
        }
      }
    }
  },
