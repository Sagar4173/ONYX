    "HIPAA": {
      "framework_info": {
        "name": "Health Insurance Portability and Accountability Act",
        "version": "2013",
        "description": "US federal law protecting sensitive patient health information from being disclosed without consent"
      },
      "controls": {
        "164.306": {
          "title": "General Security Standards",
          "description": "Covered entities must ensure confidentiality, integrity, and availability of ePHI",
          "category": "data_protection",
          "scanner_mappings": [
            {"scanner": "semgrep", "rules": ["sensitive-data-exposure", "data-validation"]},
            {"scanner": "bandit", "rules": ["B501", "B502", "B506"]},
            {"scanner": "gitleaks", "rules": ["pii", "sensitive-info", "phi"]}
          ]
        },
        "164.308.a.1": {
          "title": "Security Management Process",
          "description": "Implement policies and procedures to prevent, detect, contain, and correct security violations",
          "category": "security_management",
          "scanner_mappings": [
            {"scanner": "semgrep", "rules": ["missing-security-control", "insecure-default"]},
            {"scanner": "lynis", "rules": ["HRDN-7222", "AUTH-9204"]}
          ]
        },
        "164.312.a.1": {
          "title": "Access Control",
          "description": "Implement technical policies that allow only authorized persons access to ePHI",
          "category": "access_control",
          "scanner_mappings": [
            {"scanner": "semgrep", "rules": ["broken-access-control", "authorization-bypass", "privilege-escalation"]},
            {"scanner": "bandit", "rules": ["B101", "B102"]}
          ]
        },
        "164.312.b": {
          "title": "Audit Controls",
          "description": "Hardware, software, and procedural mechanisms that record and examine access to ePHI",
          "category": "logging",
          "scanner_mappings": [
            {"scanner": "semgrep", "rules": ["missing-security-logging", "log-injection"]},
            {"scanner": "lynis", "rules": ["LOGG-2154", "LOGG-2190"]}
          ]
        },
        "164.312.c.1": {
          "title": "Integrity Controls",
          "description": "Policies and procedures to protect ePHI from improper alteration or destruction",
          "category": "data_protection",
          "scanner_mappings": [
            {"scanner": "semgrep", "rules": ["integrity-check-missing", "tamper-detection"]},
            {"scanner": "trivy", "rules": ["INTEGRITY-CHECK", "CHECKSUM-VERIFICATION"]}
          ]
        },
        "164.312.e.1": {
          "title": "Transmission Security",
          "description": "Implement technical security measures to guard against unauthorized access to ePHI transmitted over networks",
          "category": "data_transmission",
          "scanner_mappings": [
            {"scanner": "semgrep", "rules": ["cleartext-transmission", "weak-ssl-config", "http-without-ssl"]},
            {"scanner": "bandit", "rules": ["B303", "B304", "B501"]},
            {"scanner": "lynis", "rules": ["CRYP-7902", "CRYP-7930"]}
          ]
        },
        "164.312.d": {
          "title": "Person or Entity Authentication",
          "description": "Implement procedures to verify that a person or entity seeking access to ePHI is the one claimed",
          "category": "authentication",
          "scanner_mappings": [
            {"scanner": "semgrep", "rules": ["weak-authentication", "authentication-bypass", "session-fixation"]},
            {"scanner": "bandit", "rules": ["B106", "B107"]}
          ]
        }
      }
    },
