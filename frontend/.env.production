# ==============================================================================
# ONYX Security Intelligence Platform - Frontend Production Environment
# ==============================================================================
# Copy these variables to your Vercel deployment environment
# Replace placeholder values with your actual production values
# ==============================================================================

# API CONFIGURATION - UPDATE WITH YOUR RENDER BACKEND URL
# Replace 'onyx-backend' with your actual Render service name if different
VITE_API_URL=https://onyx-backend.onrender.com/api
VITE_API_BASE_URL=https://onyx-backend.onrender.com/api

# WEBSOCKET CONFIGURATION - UPDATE WITH YOUR RENDER BACKEND URL
VITE_WS_URL=wss://onyx-backend.onrender.com
VITE_WEBSOCKET_URL=wss://onyx-backend.onrender.com

# APPLICATION SETTINGS
VITE_APP_NAME=ONYX Security Intelligence Platform
VITE_APP_VERSION=1.0.0
VITE_ENVIRONMENT=production

# FEATURE FLAGS - PRODUCTION SETTINGS
VITE_DEMO_MODE=false
VITE_DEV_MODE=false
VITE_DEBUG=false

# ANALYTICS & MONITORING - OPTIONAL
VITE_GA_TRACKING_ID=G-XXXXXXXXXX
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# THIRD-PARTY INTEGRATIONS - OPTIONAL
VITE_STRIPE_PUBLIC_KEY=pk_live_your_stripe_public_key
VITE_INTERCOM_APP_ID=your_intercom_app_id

# CDN & ASSETS - OPTIONAL
VITE_CDN_URL=https://cdn.yourdomain.com
VITE_PUBLIC_PATH=/

# SECURITY SETTINGS
VITE_FORCE_HTTPS=true
VITE_CSP_ENABLED=true
