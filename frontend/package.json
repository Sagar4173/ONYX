{
  "name": "onyx-frontend",
  "version": "1.0.0",
  "description": "ONYX - Security Intelligence Platform",
  "private": true,
  "dependencies": {
    "@heroicons/react": "^2.0.18",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "^5.0.5",
    "axios": "^1.6.2",
    "framer-motion": "^12.23.24",
    "fuse.js": "^7.5.0",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.10.3",
    "jspdf": "^2.5.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-easy-crop": "^5.5.6",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^6.20.1",
    "react-window": "^2.3.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@playwright/test": "^1.62.0",
    "@storybook/addon-a11y": "^10.5.4",
    "@storybook/addon-docs": "^10.5.4",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.4",
    "@storybook/react": "^10.5.4",
    "@storybook/react-vite": "^10.5.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "autoprefixer": "^10.4.16",
    "cross-env": "^10.0.0",
    "eslint": "^8.53.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.4",
    "eslint-plugin-storybook": "^10.5.4",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.0",
    "postcss": "^8.4.31",
    "prettier": "^3.9.6",
    "storybook": "^10.5.4",
    "tailwindcss": "^3.3.5",
    "vite": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--no-deprecation --trace-warnings\" vite --force",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{js,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\"",
    "lint": "eslint src/ --ext js,jsx --report-unused-disable-directives --max-warnings 200",
    "dev:clean": "npm cache clean --force && npm run dev",
    "dev:debug": "cross-env DEBUG=vite:* npm run dev",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install chromium"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
