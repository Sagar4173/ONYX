{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://securedevopsai-platform-production.up.railway.app/api/$1"
    },
    {
      "source": "/webhook/(.*)",
      "destination": "https://securedevopsai-platform-production.up.railway.app/webhook/$1"
    },
    {
      "source": "/health",
      "destination": "https://securedevopsai-platform-production.up.railway.app/health"
    },
    {
      "source": "/((?!api/|webhook/|health).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
