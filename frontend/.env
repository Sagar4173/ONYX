# ==============================================================================
# ONYX Platform - Frontend Environment Configuration
# ==============================================================================
# Vite Environment Variables for React Frontend
# All variables must be prefixed with VITE_ to be accessible in the browser
# ==============================================================================

# ==============================================================================
# API CONFIGURATION
# ==============================================================================
# Backend API URL - Where your FastAPI backend is running
# Development: Use /api for Vite proxy, or http://localhost:8000/api for direct
# Production: https://your-backend-domain.com/api
# Using /api to leverage Vite's proxy configuration
VITE_API_URL=/api

# Alternative API base URL (fallback)
VITE_API_BASE_URL=http://localhost:8000/api

# ==============================================================================
# WEBSOCKET CONFIGURATION
# ==============================================================================
# WebSocket URL for real-time features
# Development: ws://localhost:8000
# Production: wss://your-backend-domain.com
VITE_WS_URL=ws://localhost:8000
VITE_WEBSOCKET_URL=ws://localhost:8000

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
# Application name
VITE_APP_NAME="ONYX - Security Intelligence Platform"

# Application version
VITE_APP_VERSION="1.0.0"

# Environment (development, staging, production)
VITE_ENVIRONMENT=development

# ==============================================================================
# FEATURE FLAGS
# ==============================================================================
# Enable demo mode (uses mock data instead of real API calls)
VITE_DEMO_MODE=false

# Enable development features
VITE_DEV_MODE=true

# Enable debug logging in browser console
VITE_DEBUG=true

# ==============================================================================
# ANALYTICS & MONITORING (Optional)
# ==============================================================================
# Google Analytics tracking ID
VITE_GA_TRACKING_ID=

# Sentry DSN for error tracking
VITE_SENTRY_DSN=

# ==============================================================================
# THIRD-PARTY INTEGRATIONS (Optional)
# ==============================================================================
# Stripe public key (if implementing payments)
VITE_STRIPE_PUBLIC_KEY=

# Intercom app ID (if using customer support chat)
VITE_INTERCOM_APP_ID=

# ==============================================================================
# CDN & ASSETS (Optional)
# ==============================================================================
# CDN URL for static assets
VITE_CDN_URL=

# Public path for assets
VITE_PUBLIC_PATH=/

# ==============================================================================
# SECURITY SETTINGS
# ==============================================================================
# Enable HTTPS redirect in production
VITE_FORCE_HTTPS=false

# Content Security Policy settings
VITE_CSP_ENABLED=false
