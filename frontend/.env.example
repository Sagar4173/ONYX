# ==============================================================================
# ONYX Frontend - Environment Configuration TEMPLATE
# ==============================================================================
# Copy to .env for production builds:
#   cp .env.example .env
#
# Vite only exposes variables prefixed VITE_ to the browser bundle.
#
# Dev-server note: src/services/api.js uses http://127.0.0.1:8000/api for
# `npm run dev`. These values apply to production builds (`npm run build`).
#
# Docker/nginx note: the default same-origin proxy exposes the API at /api and
# the WebSocket at the page's own host. Do not bake 127.0.0.1 into a deployed
# image unless the backend is intentionally on the user's machine.
# ==============================================================================

# Backend API base URL for production builds.
# Docker/nginx or same-origin:              /api
# Split-domain production:                  https://api.your-domain.com/api
# Standalone local build served by Vite:    http://127.0.0.1:8000/api
VITE_API_URL=/api

# Backend WebSocket URL for production builds.
# Leave blank to derive ws:// or wss:// from the current page host.
# Split-domain production: wss://api.your-domain.com
VITE_WS_URL=

# Cosmetic/metadata
VITE_APP_NAME=ONYX Security Intelligence Platform
VITE_ENVIRONMENT=production
