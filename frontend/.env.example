# ==============================================================================
# ONYX Frontend - Environment Configuration TEMPLATE
# ==============================================================================
# Copy to .env and adjust for your environment:
#   cp .env.example .env
#
# Vite only exposes variables prefixed VITE_ to the browser bundle.
#
# Dev-server note: src/services/api.js hard-codes the backend as
# http://127.0.0.1:8000/api (and ws://127.0.0.1:8000) while import.meta.env.DEV
# is true — in `npm run dev` these values are NOT read. They take effect for
# production builds (npm run build).
#
# NEVER commit .env (it is gitignored); this .example file is the committed one.
# ==============================================================================

# Backend API base URL (used by production builds).
# Local build test:  http://127.0.0.1:8000/api
# Docker/nginx:      /api            (same-origin proxy)
# Split-domain prod: https://api.your-domain.com/api
VITE_API_URL=http://127.0.0.1:8000/api

# Backend WebSocket URL (used by production builds).
# Local build test:  ws://127.0.0.1:8000
# Split-domain prod: wss://api.your-domain.com
VITE_WS_URL=ws://127.0.0.1:8000

# Cosmetic/metadata
VITE_APP_NAME=ONYX Security Intelligence Platform
VITE_ENVIRONMENT=development
