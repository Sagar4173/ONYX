# ==============================================================================
# ONYX Frontend - Environment Configuration
# ==============================================================================
# Copy to .env and update for your environment
# ==============================================================================

# API Base URL (Required) - Backend address including /api prefix
# Development: http://127.0.0.1:8000/api
# Docker:      http://backend:8000/api
# AWS:         https://api.your-domain.com/api
VITE_API_URL=http://127.0.0.1:8000/api

# WebSocket URL (Required) - Backend WebSocket address
# Development: ws://127.0.0.1:8000
# Docker:      ws://backend:8000
# AWS:         wss://api.your-domain.com
VITE_WS_URL=ws://127.0.0.1:8000

# Application Settings
VITE_APP_NAME=ONYX Security Intelligence Platform
VITE_ENVIRONMENT=development
